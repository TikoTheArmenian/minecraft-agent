{
  "name": "minecraft-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Local Minecraft movement agent",
  "scripts": {
    "start": "node start.cjs",
    "check": "node scripts/check.cjs",
    "test": "node --test test/*.test.cjs",
    "web": "node --env-file-if-exists=.env src/main.cjs",
    "logs": "tail -n 80 -F data/logs/activity.log",
    "textures": "node scripts/extract-textures.cjs",
    "lint": "eslint src public scripts test bot.cjs start.cjs",
    "typecheck": "tsc --noEmit",
    "architecture": "node scripts/check-architecture.cjs",
    "format": "prettier --write \"src/**/*.cjs\"",
    "format:check": "prettier --check \"src/**/*.cjs\"",
    "verify": "npm run build:web && npm run check && npm run lint && npm run typecheck && npm run architecture && npm run format:check && npm test",
    "build:web": "node scripts/build-web.cjs",
    "preweb": "npm run build:web",
    "prestart": "npm run build:web"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@react-three/fiber": "9.7.0",
    "ajv": "8.20.0",
    "express": "5.2.1",
    "minecraft-protocol": "1.68.0",
    "mineflayer": "4.39.0",
    "mineflayer-armor-manager": "2.0.1",
    "mineflayer-auto-eat": "5.0.3",
    "mineflayer-collectblock": "1.6.0",
    "mineflayer-pathfinder": "2.4.5",
    "mineflayer-pvp": "1.3.2",
    "mineflayer-tool": "1.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.0",
    "vec3": "0.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.2",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "globals": "16.5.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "mineflayer-utils": {
      "mineflayer": "$mineflayer"
    }
  }
}
