# Backend only. Copy to .env and fill locally; never paste credentials into chat.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_BACKEND_SECRET_KEY
# World IDs are generated and stored automatically in Supabase.

# Shared by all bots for OpenAI messaging. Never enter this in the dashboard.
OPENAI_API_KEY=

# Optional larger model for new per-bot supervisors. Supervisors start off/paused.
SUPERVISOR_MODEL=gpt-6-astra
# Optional path to a JSON array of bot profiles; otherwise the built-in nine bots are used.
# BOT_PROFILES_FILE=./bot-profiles.local.json
